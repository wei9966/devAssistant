{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DevAssistant",
  "version": "1.1.6",
  "identifier": "com.devassistant.app",
  "build": {
    "beforeBuildCommand": "npm run build",
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "DevAssistant",
        "width": 1200,
        "height": 700,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "focus": true
      },
      {
        "label": "launcher",
        "title": "App Launcher",
        "url": "launcher.html",
        "width": 800,
        "height": 600,
        "resizable": false,
        "fullscreen": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "center": true,
        "visible": false,
        "skipTaskbar": true,
        "focus": true
      },
      {
        "label": "sql-panel",
        "title": "SQL Panel",
        "url": "sql-panel.html",
        "width": 920,
        "height": 620,
        "resizable": false,
        "fullscreen": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "center": true,
        "visible": false,
        "skipTaskbar": true,
        "focus": true
      },
      {
        "label": "quick-task",
        "title": "Quick Task",
        "url": "quick-task.html",
        "width": 700,
        "height": 130,
        "resizable": false,
        "fullscreen": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "center": true,
        "visible": false,
        "skipTaskbar": true,
        "focus": true
      },
      {
        "label": "task-float",
        "title": "Task Float",
        "url": "task-float.html",
        "width": 300,
        "height": 550,
        "x": 100,
        "y": 100,
        "resizable": false,
        "fullscreen": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "visible": false,
        "skipTaskbar": true,
        "focus": false,
        "shadow": false
      },
      {
        "label": "task-calendar",
        "title": "Task Calendar",
        "url": "task-calendar.html",
        "width": 420,
        "height": 560,
        "x": 150,
        "y": 100,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": false,
        "visible": false,
        "skipTaskbar": true,
        "focus": false,
        "shadow": false,
        "minWidth": 380,
        "minHeight": 450
      },
      {
        "label": "clipboard-history",
        "title": "Clipboard History",
        "url": "clipboard-history.html",
        "width": 480,
        "height": 680,
        "resizable": false,
        "fullscreen": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "center": true,
        "visible": false,
        "skipTaskbar": true,
        "focus": true,
        "shadow": false
      },
      {
        "label": "tool-port-checker",
        "title": "端口检查器",
        "url": "tool-port-checker.html",
        "width": 720,
        "height": 500,
        "minWidth": 500,
        "minHeight": 400,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "center": true,
        "visible": false,
        "skipTaskbar": true,
        "focus": true
      },
      {
        "label": "tool-container",
        "title": "工具",
        "url": "tool-container.html",
        "width": 720,
        "height": 500,
        "minWidth": 500,
        "minHeight": 400,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "center": true,
        "visible": false,
        "skipTaskbar": true,
        "focus": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      },
      "capabilities": [
        {
          "identifier": "main-capability",
          "description": "Main application capabilities",
          "windows": [
            "main"
          ],
          "permissions": [
            "core:default",
            "core:window:allow-start-dragging",
            "core:window:allow-show",
            "core:window:allow-hide",
            "core:window:allow-close",
            "core:window:allow-set-focus",
            "shell:allow-open",
            "dialog:allow-open",
            "dialog:allow-save",
            "fs:allow-write-text-file",
            "fs:allow-read-text-file",
            "fs:allow-write-file",
            "fs:allow-read-file",
            "fs:allow-exists",
            "global-shortcut:allow-is-registered",
            "global-shortcut:allow-register",
            "global-shortcut:allow-register-all",
            "global-shortcut:allow-unregister",
            "global-shortcut:allow-unregister-all",
            "updater:default",
            "process:allow-restart",
            "http:default"
          ]
        },
        {
          "identifier": "launcher-capability",
          "description": "Launcher window capabilities",
          "windows": [
            "launcher"
          ],
          "permissions": [
            "core:default",
            "core:window:allow-close",
            "core:window:allow-hide",
            "core:window:allow-show",
            "core:window:allow-set-focus",
            "shell:allow-open"
          ]
        },
        {
          "identifier": "sql-panel-capability",
          "description": "SQL Panel window capabilities",
          "windows": [
            "sql-panel"
          ],
          "permissions": [
            "core:default",
            "core:window:allow-close",
            "core:window:allow-hide",
            "core:window:allow-show",
            "core:window:allow-set-focus"
          ]
        },
        {
          "identifier": "quick-task-capability",
          "description": "Quick Task window capabilities",
          "windows": [
            "quick-task"
          ],
          "permissions": [
            "core:default",
            "core:window:allow-close",
            "core:window:allow-hide",
            "core:window:allow-show",
            "core:window:allow-set-focus",
            "core:window:allow-set-size",
            "core:window:allow-center"
          ]
        },
        {
          "identifier": "task-float-capability",
          "description": "Task Float window capabilities",
          "windows": [
            "task-float"
          ],
          "permissions": [
            "core:default",
            "core:window:allow-close",
            "core:window:allow-hide",
            "core:window:allow-show",
            "core:window:allow-set-focus",
            "core:window:allow-start-dragging",
            "core:window:allow-set-size",
            "core:window:allow-set-position",
            "core:window:allow-inner-size",
            "core:window:allow-outer-position",
            "core:window:allow-center"
          ]
        },
        {
          "identifier": "task-calendar-capability",
          "description": "Task Calendar window capabilities",
          "windows": [
            "task-calendar"
          ],
          "permissions": [
            "core:default",
            "core:window:allow-close",
            "core:window:allow-hide",
            "core:window:allow-show",
            "core:window:allow-set-focus",
            "core:window:allow-start-dragging",
            "core:window:allow-set-size",
            "core:window:allow-set-position",
            "core:window:allow-inner-size",
            "core:window:allow-outer-position"
          ]
        },
        {
          "identifier": "clipboard-history-capability",
          "description": "Clipboard History window capabilities",
          "windows": [
            "clipboard-history"
          ],
          "permissions": [
            "core:default",
            "core:window:allow-close",
            "core:window:allow-hide",
            "core:window:allow-show",
            "core:window:allow-set-focus",
            "dialog:allow-open"
          ]
        },
        {
          "identifier": "tool-port-checker-capability",
          "description": "Port Checker Tool window capabilities",
          "windows": [
            "tool-port-checker"
          ],
          "permissions": [
            "core:default",
            "core:window:allow-close",
            "core:window:allow-hide",
            "core:window:allow-show",
            "core:window:allow-set-focus",
            "core:window:allow-start-dragging",
            "dialog:allow-message"
          ]
        },
        {
          "identifier": "tool-container-capability",
          "description": "Tool Container window capabilities",
          "windows": [
            "tool-container"
          ],
          "permissions": [
            "core:default",
            "core:window:allow-close",
            "core:window:allow-hide",
            "core:window:allow-show",
            "core:window:allow-set-focus",
            "core:window:allow-start-dragging",
            "core:window:allow-maximize",
            "core:window:allow-unmaximize",
            "core:window:allow-is-maximized",
            "dialog:allow-message",
            "dialog:allow-open"
          ]
        }
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/icon.ico"
    ],
    "resources": [
      "config/*"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "http://d.wbdao.cn:9900/update/update.php?target={{target}}&current_version={{current_version}}"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDJFQUVDMkJBMzREOEEwNEUKUldST29OZzB1c0t1THVLVzMyRVpweGhQbUN5UHpUenBZOWpGa1JhTFN3bFhQdStuZkdGSUNUcEkK",
      "dangerousInsecureTransportProtocol": true
    }
  }
}